{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/build_vercel.mjs",
  "outputDirectory": ".vercel-static",
  "rewrites": [
    {
      "source": "/ebook",
      "destination": "/api/tracking?sc_action=ebook"
    },
    {
      "source": "/api/:action(ebook-leads|ebook|events|track)",
      "destination": "/api/tracking?sc_action=:action"
    },
    {
      "source": "/admin",
      "destination": "/api/tracking?sc_action=admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/tracking?sc_action=admin"
    },
    {
      "source": "/admin/leads.csv",
      "destination": "/api/tracking?sc_action=admin-leads"
    },
    {
      "source": "/admin/:action(login|logout)",
      "destination": "/api/tracking?sc_action=admin-:action"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(webp|png|jpg|jpeg|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
